# Cloudflare Workers static-asset headers (applies to files served from dist/client).
# The service worker and manifest must never be cached by the browser so updates
# roll out on the next load; hashed Vite assets are immutable.

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/offline
  Cache-Control: no-cache

/offline.html
  Cache-Control: no-cache

/.well-known/assetlinks.json
  Cache-Control: public, max-age=3600
  Content-Type: application/json

/assets/*
  Cache-Control: public, max-age=31536000, immutable
